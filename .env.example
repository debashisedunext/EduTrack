# EduTrack — local environment
# Copy to .env and adjust. NEVER commit .env (see .gitignore).

# ---- database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edutrack
DB_USER=edutrack_app
DB_PASSWORD=edutrack
MYSQL_ROOT_PASSWORD=rootpw

# Flyway runs as this user, never as DB_USER (A-010). The runtime user holds
# no DDL and cannot create the schema. Grants are applied by `make grants`
# after the first migration — until then the app has no access by design.
DB_MIGRATE_USER=edutrack_migrate
DB_MIGRATE_PASSWORD=edutrack_migrate

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- object storage (MinIO in dev, S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=edutrack
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- mail (Mailpit in dev — http://localhost:8025) ----
MAIL_HOST=localhost
MAIL_PORT=1025

# ---- app ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=DEBUG
