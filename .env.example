# EduTrack — local environment
# Copy to .env and adjust. NEVER commit .env (see .gitignore).

# ---- database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edutrack
DB_USER=edutrack_app
DB_PASSWORD=edutrack
MYSQL_ROOT_PASSWORD=rootpw

# Flyway runs as this user, never as DB_USER (A-010). The runtime user holds
# no DDL and cannot create the schema. Grants are applied by `make grants`
# after the first migration — until then the app has no access by design.
DB_MIGRATE_USER=edutrack_migrate
DB_MIGRATE_PASSWORD=edutrack_migrate

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- object storage (MinIO in dev, S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=edutrack
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PATH_STYLE=true

# In production (SPRING_PROFILES_ACTIVE=prod) these four change, and the prod
# profile in application.yml already defaults them correctly — set only the two
# that are deployment-specific:
#
#   S3_BUCKET=edutrack-prod-documents
#   S3_REGION=ap-south-1
#
# Leave S3_ENDPOINT blank so the SDK resolves real AWS S3 from the region, leave
# S3_ACCESS_KEY and S3_SECRET_KEY blank so the instance role is used, and leave
# S3_PATH_STYLE=false. ObjectStorageGuard refuses to start if any of these is
# still pointed at the local MinIO defaults.

# ---- mail (Mailpit in dev — http://localhost:8025) ----
MAIL_HOST=localhost
MAIL_PORT=1025

# Signs the provider bounce/complaint webhook (D-034). Unset means every
# webhook is rejected — the endpoint is unauthenticated, so this HMAC secret
# is the only thing preventing anyone from suppressing an arbitrary address.
EMAIL_WEBHOOK_SECRET=

# ---- app ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=DEBUG
