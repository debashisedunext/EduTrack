<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.edunext.edutrack</groupId>
    <artifactId>edutrack-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>edutrack-api</artifactId>
  <name>EduTrack — api</name>
  <description>REST API, security, WebSocket. Feature-packaged: api/feature/&lt;name&gt;/ per TEAM-PLAN.md §6.</description>

  <dependencies>
    <dependency><groupId>com.edunext.edutrack</groupId><artifactId>edutrack-domain</artifactId></dependency>
    <!-- B-006. The mapper annotations. They already arrive transitively through
         edutrack-common → edutrack-domain, but this is the module that writes
         @Mapper, and the jackson-dataformat-yaml note below is this pom's own
         record of what a transitive coordinate costs when the module using it
         does not declare it. The *processor* is deliberately not here: it is an
         annotationProcessorPath in the parent pom, so it never reaches the
         runtime classpath and the generated *Impl classes are MapStruct's only
         trace in the packaged jar. -->
    <dependency><groupId>org.mapstruct</groupId><artifactId>mapstruct</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <!-- A-022. NimbusJwtEncoder and NimbusJwtDecoder live here. -->
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-oauth2-jose</artifactId></dependency>
    <!-- A-032. BearerTokenAuthenticationFilter and the oauth2ResourceServer DSL.
         The library, NOT spring-boot-starter-oauth2-resource-server, for the
         reason A-022 recorded when it declined the starter: the starter's
         autoconfiguration builds a JwtDecoder from issuer-uri/jwk-set-uri, and
         this application has neither — it signs HS256 with a shared secret and
         defines its own decoder in JwtDecoderConfig, which also carries A-025's
         revocation check. Boot would back off on @ConditionalOnMissingBean, so
         the starter would work, but it would leave a second configuration path
         that only stays dormant by luck. -->
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-websocket</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-mail</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId></dependency>
    <dependency><groupId>software.amazon.awssdk</groupId><artifactId>s3</artifactId></dependency>
    <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
    <!-- Runtime, NOT test. springdoc instantiates a YAMLFactory during context
         refresh, so without this on the runtime classpath the packaged jar does
         not start at all. It arrives transitively via swagger-core, but an
         explicit declaration overrides the transitive scope — declaring it
         `test` silently removed it from the jar and CI stayed green, because the
         package job inspects the artifact without ever starting it.
         ContractConformanceTest also reads contracts/openapi.yaml with it. -->
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>mysql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <properties>
    <!-- Node is an implementation detail of the build. Nobody installs it by
         hand; frontend-maven-plugin downloads this exact version into
         target/, so every developer and CI use the same one. -->
    <node.version>v22.14.0</node.version>
    <npm.version>10.9.0</npm.version>
    <frontend.dir>${project.basedir}/../../frontend</frontend.dir>
    <!-- Backend-only build:  ./mvnw verify -DskipFrontend  -->
    <skipFrontend>false</skipFrontend>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration><mainClass>com.edunext.edutrack.EduTrackApplication</mainClass></configuration>
      </plugin>

      <!--
        A-020. Same reason as domain/pom.xml: failsafe is not inherited from
        spring-boot-starter-parent and must be declared per module. It runs
        *IT.java apart from surefire's unit tests — AuthLoginIT needs a real
        MySQL through Testcontainers — and still fails `mvn verify` if one fails.
        A-011. Was missing from this module while domain and worker had it,
        so any *IT class placed here was compiled and silently never run —
        a green build that proved nothing. Added with D-012's RealtimeRelayIT,
        which is the first integration test in api.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- ── frontend: build it, then package it into this jar ───────────── -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <workingDirectory>${frontend.dir}</workingDirectory>
          <installDirectory>${project.build.directory}</installDirectory>
          <skip>${skipFrontend}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
              <npmVersion>${npm.version}</npmVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-ci</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration><arguments>ci --no-audit --no-fund</arguments></configuration>
          </execution>
          <execution>
            <id>npm-build</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration><arguments>run build</arguments></configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-frontend-dist</id>
            <goals><goal>copy-resources</goal></goals>
            <phase>process-resources</phase>
            <configuration>
              <skip>${skipFrontend}</skip>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource><directory>${frontend.dir}/dist</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
