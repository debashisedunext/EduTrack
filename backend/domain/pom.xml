<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.edunext.edutrack</groupId>
    <artifactId>edutrack-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>edutrack-domain</artifactId>
  <name>EduTrack — domain</name>
  <description>JPA entities, repositories and Flyway migrations. Schema owned by Stream A; entities by Stream B.</description>

  <dependencies>
    <dependency><groupId>com.edunext.edutrack</groupId><artifactId>edutrack-common</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <!--
      B-005. Hibernate needs a FormatMapper to bind a JSON column to a typed
      Java value, and it picks Jackson when Jackson is on the classpath. The two
      JSON columns are workflow_stages.can_return_to and the mentioned_user_ids
      pair — PostgreSQL arrays that PLAN.md §3.1 translated to JSON because
      MySQL has no array type. Without this, those mappings fail at boot rather
      than at first read, which is at least the right end of the feedback loop
      but not a dependency we want to discover there. api and worker already
      pull Jackson transitively; declaring it here keeps `domain` buildable on
      its own.
    -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>mysql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        A-011. Not inherited from spring-boot-starter-parent — it must be
        declared per module. Bare goal list is enough: `integration-test`
        and `verify` bind to their own default lifecycle phases, which is
        the whole point of failsafe over surefire — it runs *IT.java
        classes (Testcontainers tests need a real Docker daemon and are
        slower than unit tests) separately, and still fails `mvn verify`
        if one of them fails.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
